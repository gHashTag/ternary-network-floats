create_clock -name clk -period 20.000 [get_ports clk]

# nextpnr-xilinx does not expand bus wildcards in XDC properties. Keep every
# package-facing bit explicit so a missing electrical constraint fails loudly.
set_property IOSTANDARD LVCMOS33 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports rst]
set_property IOSTANDARD LVCMOS33 [get_ports in_valid]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[8]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[9]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[10]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[11]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[12]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[13]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[14]}]
set_property IOSTANDARD LVCMOS33 [get_ports {acc[15]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[8]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[9]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[10]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[11]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[12]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[13]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[14]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sample[15]}]
set_property IOSTANDARD LVCMOS33 [get_ports {weight[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {weight[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports out_valid]
set_property IOSTANDARD LVCMOS33 [get_ports {result[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[8]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[9]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[10]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[11]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[12]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[13]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[14]}]
set_property IOSTANDARD LVCMOS33 [get_ports {result[15]}]

# Deterministic package assignment for xc7a200tsbg484. The clock uses an MRCC
# site; all other signals use bonded general-purpose I/O sites from Project X-Ray.
set_property PACKAGE_PIN D17 [get_ports clk]
set_property PACKAGE_PIN A1 [get_ports rst]
set_property PACKAGE_PIN A13 [get_ports in_valid]
set_property PACKAGE_PIN A14 [get_ports {acc[0]}]
set_property PACKAGE_PIN A15 [get_ports {acc[1]}]
set_property PACKAGE_PIN A16 [get_ports {acc[2]}]
set_property PACKAGE_PIN A18 [get_ports {acc[3]}]
set_property PACKAGE_PIN A19 [get_ports {acc[4]}]
set_property PACKAGE_PIN A20 [get_ports {acc[5]}]
set_property PACKAGE_PIN A21 [get_ports {acc[6]}]
set_property PACKAGE_PIN AA1 [get_ports {acc[7]}]
set_property PACKAGE_PIN AA3 [get_ports {acc[8]}]
set_property PACKAGE_PIN AA4 [get_ports {acc[9]}]
set_property PACKAGE_PIN AA5 [get_ports {acc[10]}]
set_property PACKAGE_PIN AA6 [get_ports {acc[11]}]
set_property PACKAGE_PIN AA8 [get_ports {acc[12]}]
set_property PACKAGE_PIN AA9 [get_ports {acc[13]}]
set_property PACKAGE_PIN AA10 [get_ports {acc[14]}]
set_property PACKAGE_PIN AA11 [get_ports {acc[15]}]
set_property PACKAGE_PIN AA13 [get_ports {sample[0]}]
set_property PACKAGE_PIN AA14 [get_ports {sample[1]}]
set_property PACKAGE_PIN AA15 [get_ports {sample[2]}]
set_property PACKAGE_PIN AA16 [get_ports {sample[3]}]
set_property PACKAGE_PIN AA18 [get_ports {sample[4]}]
set_property PACKAGE_PIN AA19 [get_ports {sample[5]}]
set_property PACKAGE_PIN AA20 [get_ports {sample[6]}]
set_property PACKAGE_PIN AA21 [get_ports {sample[7]}]
set_property PACKAGE_PIN AB1 [get_ports {sample[8]}]
set_property PACKAGE_PIN AB2 [get_ports {sample[9]}]
set_property PACKAGE_PIN AB3 [get_ports {sample[10]}]
set_property PACKAGE_PIN AB5 [get_ports {sample[11]}]
set_property PACKAGE_PIN AB6 [get_ports {sample[12]}]
set_property PACKAGE_PIN AB7 [get_ports {sample[13]}]
set_property PACKAGE_PIN AB8 [get_ports {sample[14]}]
set_property PACKAGE_PIN AB10 [get_ports {sample[15]}]
set_property PACKAGE_PIN AB11 [get_ports {weight[0]}]
set_property PACKAGE_PIN AB12 [get_ports {weight[1]}]
set_property PACKAGE_PIN AB13 [get_ports out_valid]
set_property PACKAGE_PIN AB15 [get_ports {result[0]}]
set_property PACKAGE_PIN AB16 [get_ports {result[1]}]
set_property PACKAGE_PIN AB17 [get_ports {result[2]}]
set_property PACKAGE_PIN AB18 [get_ports {result[3]}]
